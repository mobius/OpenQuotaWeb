# Copy to .env and adjust. Never commit the populated .env file.

# Optional HTTP Basic authentication for the dashboard.
# Leave both empty to disable authentication (LAN / localhost use only).
OPENQUOTA_AUTH_USER=
OPENQUOTA_AUTH_PASSWORD=

# Optional API-key providers. These are only used when no key is saved in the UI.
OPENROUTER_API_KEY=
ZAI_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=

# Optional: override Cursor state DB discovery with one or more paths.
# Supports a comma-separated list (preferred) or a single path.
OPENQUOTA_CURSOR_STATE_DBS=
OPENQUOTA_CURSOR_STATE_DB=
